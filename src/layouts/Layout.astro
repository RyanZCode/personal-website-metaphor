---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ryan Zhou',
  description = 'Ryan Zhou\'s personal website.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>

    <!-- preload the hero image so it doesn't block the entry animation -->
    <link
      rel="preload"
      as="image"
      href="/assets/dog.webp"
      fetchpriority="high"
    />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/cinzel-700.woff2"
      crossorigin="anonymous"
    />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/menu.css';
</style>
